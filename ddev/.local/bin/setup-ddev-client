#!/bin/sh

set -eu

network_id=b6ad79b0c8703cd4
dns_domain=dev.test
dns_server=10.121.16.20
test_host=wp-theme-star-engineer.dev.test
ca_source=${DDEV_CA_SOURCE:-jacocanete@10.121.16.20:.local/share/mkcert/rootCA.pem}
ca_fingerprint=3A:AA:06:90:55:C7:13:47:31:95:A3:93:21:0C:B8:40:C7:00:8C:14:88:C9:A3:BE:37:ED:8C:1C:5C:DA:47:98
ca_target=/etc/pki/ca-trust/source/anchors/home-dev-ddev-rootCA.pem
service_name=zerotier-dev-test-dns.service
service_target=/etc/systemd/system/$service_name

die() {
	printf '%s\n' "setup-ddev-client: $*" >&2
	exit 1
}

require_command() {
	command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

for command in awk curl grep install mktemp openssl resolvectl scp sudo systemctl uname update-ca-trust zerotier-cli; do
	require_command "$command"
done

[ "$(uname -s)" = Linux ] || die "only Linux clients are supported"
[ -d /etc/pki/ca-trust/source/anchors ] || die "Fedora's system CA trust store was not found"
systemctl is-active --quiet systemd-resolved || die "systemd-resolved is not active"

network_line=$(sudo zerotier-cli listnetworks | awk -v id="$network_id" '$3 == id { print; exit }')
if [ -z "$network_line" ]; then
	printf '%s\n' \
		"setup-ddev-client: this machine has not joined homelab-network" \
		"Run: sudo zerotier-cli join $network_id" \
		"Authorize the member in ZTNet, assign its managed address, then rerun this command." >&2
	exit 1
fi

network_status=$(printf '%s\n' "$network_line" | awk '{ print $6 }')
interface=$(printf '%s\n' "$network_line" | awk '{ print $8 }')
[ "$network_status" = OK ] || die "homelab-network is not online (status: $network_status)"
[ -n "$interface" ] || die "could not determine the homelab-network interface"

network_config=$(sudo zerotier-cli set "$network_id" allowDNS=1)
printf '%s\n' "$network_config" | grep -Fq '"domain":"dev.test"' ||
	die "ZTNet is not distributing the dev.test DNS domain"
printf '%s\n' "$network_config" | grep -Fq '"servers":["10.121.16.20"]' ||
	die "ZTNet is not distributing DNS server 10.121.16.20"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM

scp "$ca_source" "$tmpdir/rootCA.pem"
downloaded_fingerprint=$(
	openssl x509 -in "$tmpdir/rootCA.pem" -noout -fingerprint -sha256 |
		awk -F= '{ print $2 }'
)
[ "$downloaded_fingerprint" = "$ca_fingerprint" ] || die "DDEV CA fingerprint verification failed"

cat >"$tmpdir/$service_name" <<EOF
[Unit]
Description=Configure split DNS for ZeroTier development sites
After=zerotier-one.service systemd-resolved.service
Wants=zerotier-one.service
Requires=systemd-resolved.service
PartOf=zerotier-one.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/resolvectl dns $interface $dns_server
ExecStart=/usr/bin/resolvectl domain $interface ~$dns_domain
ExecStop=-/usr/bin/resolvectl revert $interface
RemainAfterExit=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

sudo install -o root -g root -m 0644 "$tmpdir/$service_name" "$service_target"
sudo install -o root -g root -m 0644 "$tmpdir/rootCA.pem" "$ca_target"
sudo update-ca-trust extract
sudo systemctl daemon-reload
sudo systemctl enable "$service_name" >/dev/null
sudo systemctl restart "$service_name"

resolvectl query "$test_host" >/dev/null
curl --fail --silent --show-error --head "https://$test_host" >/dev/null

printf '%s\n' \
	"DDEV client access is ready." \
	"DNS domain: $dns_domain" \
	"DNS server: $dns_server" \
	"ZeroTier interface: $interface" \
	"Verified: https://$test_host"
