{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "model": "openai/gpt-6-sol",
  "agents": {
    "title": { "model": "openai/gpt-6-luna" },
    "explore": { "disabled": true }
  },
  "permissions": [
    { "action": "subagent", "resource": "*", "effect": "deny" }
  ],
  "experimental": { "subagent_depth": 0 },
  "plugins": [
    "/home/jacocanete/.hindsight/coding-agents",
    "/home/jacocanete/dotfiles/opencode/.config/opencode/plugins/session-instructions",
    "/home/jacocanete/dotfiles/opencode/.config/opencode/plugins/ponytail"
  ],
  "skills": [
    "/home/jacocanete/.claude/plugins/marketplaces/ponytail/skills"
  ],
  "lsp": {
    "css": {
      "command": ["vscode-css-language-server", "--stdio"],
      "extensions": [".css", ".scss", ".less"]
    },
    "html": {
      "command": ["vscode-html-language-server", "--stdio"],
      "extensions": [".html", ".htm"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    }
  },
  "mcp": {
    "servers": {
      "figma": {
        "type": "local",
        "command": ["npx", "-y", "figma-developer-mcp", "--stdio"],
        "environment": {
          "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
        }
      },
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "disabled": false
      },
      "serena": {
        "type": "local",
        "command": ["serena", "start-mcp-server", "--context", "ide", "--project-from-cwd"],
        "disabled": false
      },
      "headroom": {
        "type": "local",
        "command": ["/home/jacocanete/.local/bin/headroom", "mcp", "serve"],
        "disabled": false
      }
    }
  }
}
