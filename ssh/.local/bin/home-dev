#!/bin/sh

set -eu

target=home-server-dev
action=${1:-}

if [ "$action" = "send" ]; then
	if [ "$#" -ne 2 ]; then
		printf '%s\n' "usage: home-dev send <local-file>" >&2
		exit 1
	fi

	local_file=$2
	if [ ! -f "$local_file" ]; then
		printf '%s\n' "home-dev: file not found: $local_file" >&2
		exit 1
	fi
fi

result=$(
	ssh -o BatchMode=yes -o ConnectTimeout=5 home-server '
		state=$(LC_ALL=C virsh -c qemu:///system domstate home-dev 2>/dev/null) || exit 1
		if [ "$state" = "running" ]; then
			printf "%s\n" running
		elif virsh -c qemu:///system start home-dev >/dev/null 2>&1; then
			printf "%s\n" started
		elif [ "$(LC_ALL=C virsh -c qemu:///system domstate home-dev 2>/dev/null)" = "running" ]; then
			printf "%s\n" running
		else
			exit 1
		fi
	'
) || {
	printf '%s\n' "home-dev: could not start the VM" >&2
	exit 1
}

if [ "$result" = "started" ]; then
	printf '%s\n' "home-dev: VM started; waiting for SSH"
fi

attempt=0
while [ "$attempt" -lt 45 ]; do
	if ssh -o BatchMode=yes -o ConnectTimeout=3 "$target" true 2>/dev/null; then
		if [ "$action" = "send" ]; then
			ssh "$target" 'mkdir -p "$HOME/Uploads"'
			scp "$local_file" "$target:Uploads/"
			remote_home=$(ssh "$target" 'printf %s "$HOME"')
			remote_path="$remote_home/Uploads/$(basename "$local_file")"

			if command -v wl-copy >/dev/null 2>&1; then
				printf '%s' "$remote_path" | wl-copy >/dev/null 2>&1 || true
			fi

			printf '%s\n' "$remote_path"
			exit 0
		fi

		exec ssh "$target" "$@"
	fi
	attempt=$((attempt + 1))
	sleep 1
done

printf '%s\n' "home-dev: SSH did not become ready" >&2
exit 1
