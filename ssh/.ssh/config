Include ~/.ssh/config.local

#Personal Github
Host personalgit
	HostName github.com
	User git
	IdentityFile ~/.ssh/personal.pub
	IdentitiesOnly yes

#Work Github
Host workgit
	HostName github.com
	User git
	IdentityFile ~/.ssh/work.pub
	IdentitiesOnly yes

# Servers
Host home-server
    HostName 10.121.16.22
    User root
Host home-server-dev
    HostName 192.168.122.10
    User jacocanete
    ProxyJump jacocanete@home-server
Host hostinger-vps-1
    HostName 10.121.15.164
    User root
Host hostinger-vps-2
    HostName 10.121.15.49
    User root

# Pantheon (rebuild site) — git push/pull uses the site-specific key only
Host *.drush.in
    IdentityFile ~/.ssh/pantheon_rebuild
    IdentitiesOnly yes
